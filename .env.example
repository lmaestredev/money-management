# --- Base de datos: Supabase Postgres ---
# Dashboard → Project Settings → Database → Connection string
# Define AMBAS. app/lib/db.ts elige automáticamente:
#   - Serverless (Vercel)      -> POSTGRES_URL (Transaction Pooler 6543, prepared statements OFF)
#   - Persistente (next dev/start, self-hosted) -> POSTGRES_URL_NON_POOLING (Session Pooler 5432, prepared statements ON)
#
# Transaction Pooler — puerto 6543 (serverless).
POSTGRES_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Session Pooler — puerto 5432 (servidor persistente y migraciones). IPv4, soporta DDL.
#   Alternativa: Direct connection (db.<project-ref>.supabase.co:5432) si tu red tiene IPv6.
POSTGRES_URL_NON_POOLING=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Desarrollo local con Docker (docker-compose.yml) — usa esto en su lugar:
#   POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/money_management
#   POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@localhost:5433/money_management

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth

# Optional: token for POST/GET /api/movements (e.g. Telegram bot). If set, requests must send Authorization: Bearer <token>
TELEGRAM_BOT_SECRET=
# Alternative env name for the same purpose
API_SECRET=